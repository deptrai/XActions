+
+    const wrapped = await wrapToolResult('x_scrape', originalEnvelope, Date.now());
+    assert.equal(wrapped, originalEnvelope);
+  });
+});
diff --git a/tests/mcp/x-scrape-tool.test.js b/tests/mcp/x-scrape-tool.test.js
