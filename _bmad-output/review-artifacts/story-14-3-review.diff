+
+    const mockStore = {
+      publisher: mockPublisher,
+      storeBatch: async () => {},
+      saveCheckpoint: async (checkpoint) => {
+        savedCheckpoints.push(checkpoint);
+        return checkpoint;
+      },
+    };
+
+    const client = new FacebookClient({
+      baseUrl: serverUrl,
+      graphqlEndpoint: `${serverUrl}/api/graphql/`,
+    });
+
+    const crawler = new FacebookCrawler({
+      client,
+      store: mockStore,
+    });
