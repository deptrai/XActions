+      throw new PlatformError({
+        code: 'XACT_4001',
+        type: ErrorTypes.INVALID_ARGS,
+        message: 'Missing or invalid Facebook postUrl for Messenger share',
+        suggestedAction: SuggestedActions.USE_ACTIONS_LIST,
