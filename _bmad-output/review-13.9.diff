+  }
+
+  /**
+   * Share a post or message via Messenger to one or more recipient UIDs.
+   * @param {Object} args
+   * @param {string} args.postUrl
+   * @param {string|string[]} [args.recipientUids]
+   * @param {string} [args.recipientUid]
