+import { describe, test, expect, beforeEach } from 'vitest';
+import { PrismaStore } from '../../src/store/prisma-store.js';
+import metadataSchemaRegistry from '../../src/core/metadata-schema-registry.js';
+import { PlatformError } from '../../src/core/error-envelope.js';
+
+describe('PrismaStore Metadata Validation Hook', () => {
+  let store;
+
+  beforeEach(() => {
+    store = new PrismaStore({ tenantId: 'test' });
+    metadataSchemaRegistry.registerSchema('dummy', 'social', {
+      type: 'object',
+      properties: { count: { type: 'integer' } },
+      required: ['count']
+    });
+  });
+
+  test('storeContent should throw XACT_4001 if metadata violates schema', async () => {
+    const invalidItem = {
+      platform: 'dummy',
+      category: 'social',
+      externalId: '123',
+      type: 'post',
+      content: 'test',
+      metadata: { count: 'not-a-number' }
+    };
+    
+    await expect(store.storeContent(invalidItem)).rejects.toThrow(PlatformError);
+    await expect(store.storeContent(invalidItem)).rejects.toHaveProperty('code', 'XACT_4001');
+  });
+
+  test('storeBatch should throw XACT_4001 before transaction if any item is invalid', async () => {
+    const items = [
+      { platform: 'dummy', category: 'social', externalId: '1', type: 'post', content: 'valid', metadata: { count: 1 } },
+      { platform: 'dummy', category: 'social', externalId: '2', type: 'post', content: 'invalid', metadata: { count: 'bad' } }
+    ];
+    
+    await expect(store.storeBatch(items)).rejects.toThrow(PlatformError);
+    await expect(store.storeBatch(items)).rejects.toMatchObject({
+      code: 'XACT_4001',
+      message: expect.stringContaining('index 1')
+    });
+  });
+
+  test('storeContent should allow insertion if validateSchema bypass is used', async () => {
+    store = new PrismaStore({
+      tenantId: 'test',
+      prisma: { post: { createMany: async () => {} }, $connect: async () => {} }
+    });
+    const invalidItem = {
+      platform: 'dummy',
+      category: 'social',
+      externalId: '123',
+      type: 'post',
+      content: 'test',
+      metadata: { count: 'not-a-number' }
+    };
+    
+    await expect(store.storeContent(invalidItem, { validateSchema: false })).resolves.not.toThrow();
+  });
+});

