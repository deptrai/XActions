{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Twitter Social Post & Profile Metadata",
  "type": "object",
  "required": [
    "tweetId"
  ],
  "properties": {
    "tweetId": {
      "type": "string"
    },
    "parentTweetId": {
      "type": ["string", "null"]
    },
    "conversationId": {
      "type": ["string", "null"]
    },
    "isThread": {
      "type": "boolean"
    },
    "isBookmarked": {
      "type": "boolean"
    },
    "username": {
      "type": "string"
    },
    "profileId": {
      "type": "string"
    },
    "avatar": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "isProfile": {
      "type": "boolean"
    },
    "isFollower": {
      "type": "boolean"
    },
    "isFollowing": {
      "type": "boolean"
    },
    "isLiker": {
      "type": "boolean"
    },
    "isRetweeter": {
      "type": "boolean"
    },
    "isListMember": {
      "type": "boolean"
    },
    "isNonFollower": {
      "type": "boolean"
    },
    "isReply": {
      "type": "boolean"
    },
    "isRetweet": {
      "type": "boolean"
    },
    "isQuote": {
      "type": "boolean"
    },
    "isVerified": {
      "type": "boolean"
    },
    "protected": {
      "type": "boolean"
    },
    "isSearchResult": {
      "type": "boolean"
    },
    "searchType": {
      "type": "string"
    },
    "searchFilter": {
      "type": "string"
    },
    "searchQuery": {
      "type": "string"
    },
    "isHashtag": {
      "type": "boolean"
    },
    "hashtag": {
      "type": "string"
    },
    "isTrending": {
      "type": "boolean"
    },
    "isTrend": {
      "type": "boolean"
    },
    "trendWoeid": {
      "type": "integer"
    },
    "woeid": {
      "type": "integer"
    },
    "tweetCount": {
      "type": ["integer", "null"]
    },
    "trendUrl": {
      "type": ["string", "null"]
    },
    "category": {
      "type": ["string", "null"]
    },
    "isPromoted": {
      "type": "boolean"
    },
    "resultType": {
      "type": "string"
    },
    "followersCount": {
      "type": "integer",
      "minimum": 0
    },
    "followingCount": {
      "type": "integer",
      "minimum": 0
    },
    "likeCount": {
      "type": "integer",
      "minimum": 0
    },
    "retweetCount": {
      "type": "integer",
      "minimum": 0
    },
    "replyCount": {
      "type": "integer",
      "minimum": 0
    },
    "quoteCount": {
      "type": "integer",
      "minimum": 0
    },
    "bookmarkCount": {
      "type": "integer",
      "minimum": 0
    },
    "lang": {
      "type": "string"
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "listId": {
      "type": "string"
    },
    "cursor": {
      "type": "string"
    },
    "sourceMethod": {
      "type": "string"
    },
    "isMedia": {
      "type": "boolean"
    },
    "mediaType": {
      "type": ["string", "null"]
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "url": { "type": "string" },
          "thumbnailUrl": { "type": "string" },
          "width": { "type": "integer" },
          "height": { "type": "integer" },
          "durationMs": { "type": ["integer", "null"] },
          "bitrate": { "type": ["integer", "null"] },
          "contentType": { "type": "string" },
          "variants": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "properties": {
                "bitrate": { "type": "integer" },
                "contentType": { "type": "string" },
                "url": { "type": "string" }
              }
            }
          },
          "altText": { "type": ["string", "null"] },
          "mediaKey": { "type": "string" }
        }
      }
    }
  }
}
