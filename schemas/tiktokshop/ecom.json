{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TikTok Shop Ecommerce Product Metadata",
  "type": "object",
  "properties": {
    "productId": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" }
      ]
    },
    "shopId": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" }
      ]
    },
    "shopName": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string"
    },
    "originalPrice": {
      "type": "number",
      "minimum": 0
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "soldCount": {
      "type": "integer",
      "minimum": 0
    },
    "commissionRate": {
      "type": "number",
      "minimum": 0
    },
    "commissionAmount": {
      "type": "number",
      "minimum": 0
    },
    "sourceMethod": {
      "type": "string",
      "enum": ["top_products", "product_detail", "search_products"]
    }
  },
  "required": [
    "productId",
    "shopId",
    "price"
  ]
}
