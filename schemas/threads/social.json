{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Threads Social Post Metadata",
  "type": "object",
  "properties": {
    "postCode": {
      "type": "string"
    },
    "mediaType": {
      "type": "string"
    },
    "isReply": {
      "type": "boolean"
    },
    "carousel": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replyControl": {
      "type": "string"
    },
    "sourceMethod": {
      "type": "string"
    }
  },
  "required": [
    "postCode",
    "mediaType",
    "sourceMethod"
  ]
}
